<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>Sansalica</title>
	</head>
	<body>
		<script is:inline>
			(function () {
				try {
					var t = localStorage.getItem('theme');
					if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
					else document.documentElement.removeAttribute('data-theme');
				} catch (_) {}
			})();
		</script>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--color-navy: #1d3872;
		--color-navy-dark: #1b2a4a;
		--color-navy-mid: #2f4167;
		--color-gold: #c9a96e;
		--color-gold-light: #cfac6d;
		--color-white: #ffffff;
		--color-gray: #abb2bb;
		--color-gray-blue: #b0bac5;
		--color-gray-mid: #61758a;
		--color-light: #F4F1E8;
		--color-success: #20be5b;
		--font-primary: 'Playfair Display', serif;

		--bg-page: #F4F1E8;
		--bg-card: #ffffff;
		--text-primary: #1d3872;
		--text-secondary: #61758a;
		--border-color: #e4e0d5;
	}

	[data-theme='dark'] {
		--bg-page: #0d1524;
		--bg-card: #162035;
		--text-primary: #e8edf8;
		--text-secondary: #8fa3bb;
		--border-color: #243050;
		--color-gray: #3a4a60;
		--color-light: #0d1524;
		--color-white: #162035;
		--color-navy: #e8edf8;
		--color-gray-mid: #8fa3bb;
		--color-navy-dark: #081020;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		font-family: var(--font-primary);
		background-color: var(--bg-page);
		color: var(--text-primary);
		transition: background-color 0.25s ease, color 0.25s ease;
	}
</style>
