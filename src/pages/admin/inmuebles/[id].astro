---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { InmuebleDetailClient } from '@/components/inmuebles/InmuebleDetailClient';
import * as inmuebleRepository from '@/repositories/inmuebleRepository';
import { withAuthRetry, UnauthorizedError } from '@/repositories/withAuthRetry';

const { id } = Astro.params;

let inmueble;
try {
  inmueble = await withAuthRetry(Astro.cookies, (token) => inmuebleRepository.get(token, id!));
} catch (error) {
  if (error instanceof UnauthorizedError) {
    return Astro.redirect('/login');
  }
  return Astro.redirect('/admin/inmuebles');
}
---

<AdminLayout title={inmueble.title}>
  <div class="page-container">
    <InmuebleDetailClient inmueble={inmueble} client:load />
  </div>
</AdminLayout>
