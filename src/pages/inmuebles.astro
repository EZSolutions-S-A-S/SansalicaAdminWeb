---
import AdminLayout from '../layouts/AdminLayout.astro';
import InmuebleCard from '../components/InmuebleCard.astro';

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://127.0.0.1:8000/api/';

let inmuebles = [];
let error = null;

try {
	const response = await fetch(`${API_URL}inmuebles/`);
	if (response.ok) {
		const data = await response.json();
		inmuebles = data.results || [];
	} else {
		throw new Error('Failed to fetch from backend');
	}
} catch (e) {
	console.error('Error fetching data, falling back to mock data:', e.message);
	error = e.message;
	
	inmuebles = [
		{
			id: 1,
			title: 'Penthouse Panorámico en El Rosales',
			location: 'Bogotá - El Rosales | Penthouse',
			price: '2900000000.00',
