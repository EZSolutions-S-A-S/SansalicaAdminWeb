			photos: [{ url: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=400&q=80' }]
		},
		{
			id: 3,
			title: 'Casa Colonial en Castillogrande',
			location: 'Cartagena - Castillogrande | Casa',
			price: '4200000000.00',
			square_meters: '480.00',
			operation_type: 'Venta',
			status: 'Disponible',
			photos: [{ url: 'https://images.unsplash.com/photo-1580587771525-78b9dba3b914?w=400&q=80' }]
		},
		{
			id: 4,
			title: 'Apartamento Ejecutivo en Laureles',
