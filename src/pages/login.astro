---
import '@/styles/tokens.css';
import '@/styles/admin.css';
import { LoginForm } from '@/components/auth/LoginForm';
import bgLogin from '@/assets/bg-login.svg';
import logo from '@/assets/logo.svg';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>Ingresar · Panel Sansalica</title>
  </head>
  <body>
    <div class="login-page">
      <img class="login-bg" src={bgLogin.src} alt="" aria-hidden="true" />

      <div class="login-card">
        <div class="login-logo">
          <img src={logo.src} alt="Logo Sansalica" class="login-logo__img" />
        </div>

        <LoginForm client:load />
      </div>
    </div>
  </body>
</html>
